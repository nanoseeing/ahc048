   "source": [
    "# 組み合わせ\n",
    "def comb(n, k):\n",
    "    k = min(k, n - k)\n",
    "\n",
    "    m = 1\n",
    "    for i in range(n, n - k, -1):\n",
    "        m *= i\n",
    "\n",
    "    n = 1\n",
    "    for i in range(1, k + 1):\n",
    "        n *= i\n",
    "\n",
    "    return m // n\n",
    "\n",
    "\n",
    "for n in range(4, 21):\n",
    "    for k in range(2, n+1):\n",
    "        print(n, k, comb(n, k))\n",
    "    print()"
   ]
  }
